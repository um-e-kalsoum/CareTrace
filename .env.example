# Get the account identifier and user from your Snowflake account details.
# Server-only credentials: NEVER prefix these with NEXT_PUBLIC_ or commit .env.local.
SNOWFLAKE_ACCOUNT=yourorg-youraccount
SNOWFLAKE_USER=YOUR_LOGIN_NAME
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=CARETRACE_APP_ROLE
SNOWFLAKE_AUTHENTICATOR=PROGRAMMATIC_ACCESS_TOKEN
SNOWFLAKE_TOKEN=replace_with_pat
# Optional alternative if PAT setup is blocked and SSO configured (local only):
# SNOWFLAKE_AUTHENTICATOR=EXTERNALBROWSER
# To use password-based authentication instead, set SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE and SNOWFLAKE_PASSWORD.
